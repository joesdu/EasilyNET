{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  //"Kestrel": {
  //  "Endpoints": {
  //    "Http": {
  //      "Url": "http://*:5000"
  //    }
  //  }
  //},
  "ConnectionStrings": {
    // 当MongoDB副本集无法通过多个主机名或IP连接时,可仅连接主节点,并添加 &directConnection=true 参数如:
    // mongodb://joe:a123456@127.0.0.1:27017/?replicaSet=rs0&authSource=admin&serverSelectionTimeoutMS=1000&directConnection=true
    // 副本集成员通告为 127.0.0.1:端口(见 docker-compose.mongo.rs.yml),Kiri 下宿主机无法通过 host.docker.internal 访问发布端口
    "Mongo": "mongodb://joe:a123456@127.0.0.1:27017,127.0.0.1:27018,127.0.0.1:27019/?replicaSet=rs0&authSource=admin&serverSelectionTimeoutMS=1000",
    "Rabbit": "amqp://admin:a123456@127.0.0.1:5672/%2f",
    "Garnet": "127.0.0.1:6379,password=a123456"
  },
  "OpenTelemetry": {
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317"
  }
}